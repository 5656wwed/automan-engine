# AutoScene Studio - Environment Configuration
#
# NOTE: API keys are NO LONGER read from this file by default.
# Open the app and go to Settings -> API Keys to enter and save
# your keys. They will be stored privately in your user profile
# (settings.json under %APPDATA%/AutoSceneStudio on Windows or
# ~/.config/AutoSceneStudio elsewhere).

# === FFmpeg ===
FFMPEG_PATH=C:\Users\HP\Desktop\AutoVD\.tools\ffmpeg\bin\ffmpeg.exe

# === Defaults ===
DEFAULT_TTS_PROVIDER=edge
DEFAULT_VOICE_ID=
DEFAULT_RESOLUTION=1920x1080
DEFAULT_FPS=30
DEFAULT_TRANSITION=fade
DEFAULT_MOTION=zoom_out
